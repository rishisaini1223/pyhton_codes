class Solution:
    def reverse(self, x: int) -> int:
        sign = 1
        
        y = 0
        if x>0 :
            sign = 1
        else:
            sign = -1
        x=abs(x)
        
        while x>0:
            d = x%10
            y = y*10+d
            x //=10
        

        return y*sign
